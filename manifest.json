{
  "manifest_version": 3,
  "name": "Fidelity Margin Calculator Auto",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Automatically shows margin impact when entering trades on Fidelity",
  "host_permissions": [
    "https://digital.fidelity.com/*",
    "https://fundresearch.fidelity.com/*",
    "https://www.irs.gov/*",
    "https://taxfoundation.org/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://digital.fidelity.com/ftgw/digital/*"],
      "js": [
        "lib/constants.js",
        "lib/debug.js",
        "lib/retry.js",
        "lib/fetch-utils.js",
        "lib/api-error.js",
        "lib/positions.js",
        "lib/margin-api.js",
        "lib/margin-calc.js",
        "lib/chain-estimate.js",
        "lib/roll-model.js",
        "lib/chain-api.js",
        "lib/tax-rates.js",
        "lib/tax-context.js",
        "lib/mmf-model.js",
        "lib/rate-limiter.js",
        "content/detector.js",
        "content/injector.js",
        "content/main.js",
        "content/chain-core.js",
        "content/chain.js",
        "content/roll.js",
        "content/ticket-assist.js",
        "content/mmf.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fidelity Margin Calculator Auto",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
