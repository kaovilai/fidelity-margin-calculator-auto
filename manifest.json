{
  "manifest_version": 3,
  "name": "Fidelity Margin Calculator Auto",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Automatically shows margin impact when entering trades on Fidelity",
  "host_permissions": [
    "https://digital.fidelity.com/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://digital.fidelity.com/ftgw/digital/*"],
      "js": [
        "lib/constants.js",
        "lib/debug.js",
        "lib/retry.js",
        "lib/fetch-utils.js",
        "lib/positions.js",
        "lib/margin-api.js",
        "lib/margin-calc.js",
        "lib/rate-limiter.js",
        "content/detector.js",
        "content/injector.js",
        "content/main.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fidelity Margin Calculator Auto"
  }
}
